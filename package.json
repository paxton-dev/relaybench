{
  "name": "relaybench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:functions && npm run build:demo",
    "build:demo": "vite build --config apps/demo/vite.config.ts",
    "build:functions": "node scripts/build-functions.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "vite --config apps/demo/vite.config.ts",
    "format:terraform": "terraform -chdir=infrastructure fmt -recursive",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1121.0",
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/client-eventbridge": "^3.1121.0",
    "@aws-sdk/lib-dynamodb": "^3.1121.0",
    "ajv": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
